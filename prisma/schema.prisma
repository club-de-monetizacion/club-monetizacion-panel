generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SOPORTE
  EDITOR
  MIEMBRO
}

enum Platform {
  SKOOL
  SKOOL_UPDATES
  YOUTUBE
  TIKTOK
  INSTAGRAM
  FACEBOOK
}

enum ContentStage {
  IDEA
  PLANEADO
  GRABADO
  EDITANDO
  EDITADO
  PUBLICADO
}

enum TaskType {
  SOPORTE
  CONTENIDO
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  EN_REVISION
  COMPLETADA
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum BackgroundType {
  PARTICLES
  AURORA
  GRADIENT
  SOLID
}

/** The kind of a whiteboard element on an idea's canvas. */
enum BoardElementKind {
  STICKY
  TEXT
  TITLE
  IMAGE
  SHAPE_RECTANGLE
  SHAPE_CIRCLE
  SHAPE_LINE
  SHAPE_CROSS
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?   @db.Text
  role             Role      @default(MIEMBRO)
  bio              String?
  accentColor      String    @default("#8b5cf6")
  backgroundType   BackgroundType @default(PARTICLES)
  backgroundColor  String    @default("#0b0f19")
  particlesEnabled Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  assignedTasks    Task[]    @relation("AssignedTasks")
  createdTasks     Task[]    @relation("CreatedTasks")
  createdProjects  Project[]
  comments         Comment[]
  cannedResponses  CannedResponse[]
  quickLinks       QuickLink[]
  ideas            Idea[]
  ideaNodes        IdeaNode[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  platform    Platform
  driveLink   String?
  color       String    @default("#6366f1")
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  tasks       Task[]

  @@index([platform])
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  notes       String?       @db.Text
  coverImage  String?       @db.Text
  type        TaskType
  status      TaskStatus    @default(PENDIENTE)
  stage       ContentStage?
  platform    Platform?
  priority    Priority      @default(MEDIA)
  dueDate     DateTime?
  driveLink   String?
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assigneeId  String?
  assignee    User?         @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User          @relation("CreatedTasks", fields: [createdById], references: [id])

  comments       Comment[]
  attachments    Attachment[]
  checklistItems ChecklistItem[]

  @@index([type, status])
  @@index([platform, stage])
  @@index([assigneeId])
}

/** A manually managed to-do item on a task, e.g. production steps for a video. */
model ChecklistItem {
  id        String   @id @default(cuid())
  label     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
}

/** A screenshot or document attached to a task (e.g. a Skool update). */
model Attachment {
  id        String         @id @default(cuid())
  kind      AttachmentKind
  name      String
  dataUrl   String         @db.Text
  size      Int
  createdAt DateTime       @default(now())

  taskId    String
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
}

/** Canned answers the support team can copy-paste into a conversation. */
model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
}

/** Frequently-needed links (docs, forms, dashboards) kept handy to copy. */
model QuickLink {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
}

/** A quick idea the team jotted down to revisit later. */
model Idea {
  id        String           @id @default(cuid())
  body      String           @db.Text
  color     String           @default("#fef08a")
  kind      BoardElementKind @default(STICKY)
  x         Float            @default(0)
  y         Float            @default(0)
  width     Float            @default(224)
  height    Float            @default(160)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  nodes       IdeaNode[]

  nodeConnections IdeaNodeConnection[]
  connectionsFrom IdeaConnection[]     @relation("IdeaConnFrom")
  connectionsTo   IdeaConnection[]     @relation("IdeaConnTo")
}

/** An arrow connecting two ideas on the shared Pizarra board. */
model IdeaConnection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sourceId String
  source   Idea   @relation("IdeaConnFrom", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   Idea   @relation("IdeaConnTo", fields: [targetId], references: [id], onDelete: Cascade)
}

/** An element (sticky note, text, title, or shape) on an idea's own
 * whiteboard, used to develop it further. */
model IdeaNode {
  id        String           @id @default(cuid())
  body      String           @db.Text
  color     String           @default("#fef08a")
  kind      BoardElementKind @default(STICKY)
  x         Float            @default(0)
  y         Float            @default(0)
  width     Float            @default(224)
  height    Float            @default(160)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  connectionsFrom IdeaNodeConnection[] @relation("IdeaNodeConnFrom")
  connectionsTo   IdeaNodeConnection[] @relation("IdeaNodeConnTo")
}

/** An arrow connecting two elements within a single idea's own whiteboard. */
model IdeaNodeConnection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  sourceId String
  source   IdeaNode @relation("IdeaNodeConnFrom", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   IdeaNode @relation("IdeaNodeConnTo", fields: [targetId], references: [id], onDelete: Cascade)
}

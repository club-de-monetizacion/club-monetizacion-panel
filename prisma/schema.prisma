generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SOPORTE
  EDITOR
  MIEMBRO
}

enum Platform {
  SKOOL
  SKOOL_UPDATES
  YOUTUBE
  TIKTOK
  INSTAGRAM
  FACEBOOK
}

enum ContentStage {
  IDEA
  PLANEADO
  GRABADO
  EDITANDO
  EDITADO
  PUBLICADO
}

enum TaskType {
  SOPORTE
  CONTENIDO
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  EN_REVISION
  COMPLETADA
}

/// Los cuatro tipos de la captura rápida de Pendientes (la app de escritorio de
/// Diego). No se mezclan con TaskType, que es del tablero del equipo.
enum KindPendiente {
  TAREA
  IDEA
  VIDEO
  SKOOL
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum BackgroundType {
  PARTICLES
  AURORA
  GRADIENT
  SOLID
}

/**
 * How often a daily task item is scheduled to show up on the checklist.
 */
enum TaskRecurrence {
  DAILY
  WEEKLY
  ONCE
}

/**
 * SUPPORT is the shared support checklist (visible to admins in the
 * monitoring page); PERSONAL is private to its owner and never shown there.
 */
enum TaskCategory {
  SUPPORT
  PERSONAL
}

/**
 * The kind of a whiteboard element on an idea's canvas.
 */
enum BoardElementKind {
  STICKY
  TEXT
  TITLE
  IMAGE
  SHAPE_RECTANGLE
  SHAPE_CIRCLE
  SHAPE_LINE
  SHAPE_CROSS
}

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String         @unique
  emailVerified    DateTime?
  image            String?        @db.Text
  role             Role           @default(MIEMBRO)
  bio              String?
  accentColor      String         @default("#c9a040")
  backgroundType   BackgroundType @default(PARTICLES)
  backgroundColor  String         @default("#05091a")
  particlesEnabled Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  accounts        Account[]
  sessions        Session[]
  assignedTasks   Task[]           @relation("AssignedTasks")
  createdTasks    Task[]           @relation("CreatedTasks")
  createdProjects Project[]
  comments        Comment[]
  cannedResponses CannedResponse[]
  faqItems        FaqItem[]
  quickLinks      QuickLink[]
  ideas           Idea[]
  ideaNodes       IdeaNode[]
  dailyTaskItems  DailyTaskItem[]
  dailyTaskLogs   DailyTaskLog[]
  personalTasks   PersonalTask[]
  perfilCreador   PerfilCreador?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  platform    Platform
  driveLink   String?
  color       String   @default("#6366f1")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  tasks       Task[]

  @@index([platform])
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  notes       String?       @db.Text
  coverImage  String?       @db.Text
  type        TaskType
  status      TaskStatus    @default(PENDIENTE)
  stage       ContentStage?
  platform    Platform?
  priority    Priority      @default(MEDIA)
  dueDate     DateTime?
  driveLink   String?
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])

  comments       Comment[]
  attachments    Attachment[]
  checklistItems ChecklistItem[]

  @@index([type, status])
  @@index([platform, stage])
  @@index([assigneeId])
}

/**
 * A manually managed to-do item on a task, e.g. production steps for a video.
 */
model ChecklistItem {
  id        String   @id @default(cuid())
  label     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
}

/**
 * A screenshot or document attached to a task (e.g. a Skool update).
 */
model Attachment {
  id        String         @id @default(cuid())
  kind      AttachmentKind
  name      String
  dataUrl   String         @db.Text
  size      Int
  createdAt DateTime       @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

/**
 * Canned answers the support team can copy-paste into a conversation.
 */
model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
}

/**
 * A common support question paired with the answer to copy and send.
 */
model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
}

/**
 * Frequently-needed links (docs, forms, dashboards) kept handy to copy.
 */
model QuickLink {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
}

/**
 * A quick idea the team jotted down to revisit later.
 */
model Idea {
  id        String           @id @default(cuid())
  body      String           @db.Text
  color     String           @default("#fef08a")
  kind      BoardElementKind @default(STICKY)
  x         Float            @default(0)
  y         Float            @default(0)
  width     Float            @default(224)
  height    Float            @default(160)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  nodes       IdeaNode[]

  nodeConnections IdeaNodeConnection[]
  connectionsFrom IdeaConnection[]     @relation("IdeaConnFrom")
  connectionsTo   IdeaConnection[]     @relation("IdeaConnTo")
}

/**
 * An arrow connecting two ideas on the shared Pizarra board.
 */
model IdeaConnection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sourceId String
  source   Idea   @relation("IdeaConnFrom", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   Idea   @relation("IdeaConnTo", fields: [targetId], references: [id], onDelete: Cascade)
}

/**
 * An element (sticky note, text, title, or shape) on an idea's own
 * whiteboard, used to develop it further.
 */
model IdeaNode {
  id        String           @id @default(cuid())
  body      String           @db.Text
  color     String           @default("#fef08a")
  kind      BoardElementKind @default(STICKY)
  x         Float            @default(0)
  y         Float            @default(0)
  width     Float            @default(224)
  height    Float            @default(160)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  connectionsFrom IdeaNodeConnection[] @relation("IdeaNodeConnFrom")
  connectionsTo   IdeaNodeConnection[] @relation("IdeaNodeConnTo")
}

/**
 * An arrow connecting two elements within a single idea's own whiteboard.
 */
model IdeaNodeConnection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  sourceId String
  source   IdeaNode @relation("IdeaNodeConnFrom", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   IdeaNode @relation("IdeaNodeConnTo", fields: [targetId], references: [id], onDelete: Cascade)
}

/**
 * A recurring daily task template owned by one team member (e.g. someone
 * on support). Not date-scoped itself — "today done or not" is derived from
 * whether a DailyTaskLog exists for today, which is what gives the natural
 * daily reset without needing a cron job.
 */
model DailyTaskItem {
  id         String         @id @default(cuid())
  label      String
  position   Int            @default(0)
  category   TaskCategory   @default(SUPPORT)
  recurrence TaskRecurrence @default(DAILY)
  /**
   * Used when recurrence = WEEKLY. JS getUTCDay() convention: 0=Sun..6=Sat.
   */
  weekdays   Int[]          @default([])
  /**
   * Used when recurrence = ONCE — the single day this task is scheduled for.
   */
  onDate     DateTime?      @db.Date
  createdAt  DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  logs DailyTaskLog[]

  @@index([userId])
}

/**
 * One completion record for one task on one calendar day. Its mere
 * existence means "done that day" — checking a box creates it, unchecking
 * deletes it — so history simply accumulates as time passes.
 */
model DailyTaskLog {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  completedAt DateTime @default(now())

  itemId String
  item   DailyTaskItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, date])
  @@index([userId, date])
}

/**
 * A private "someday" list, entirely separate from the recurring daily
 * checklist above: jot a quick idea or task down, flesh it out with a
 * description whenever you get to it, check it off, and it quietly moves
 * itself to the archive a day later. Owned by exactly one user — no admin
 * override anywhere in the code that touches this model, unlike
 * DailyTaskItem's SUPPORT category. "Archived" isn't a stored flag: it's
 * derived from doneAt so unchecking a task always brings it right back.
 */
/// Los pendientes privados de cada persona: lo que antes era la app de escritorio
/// "Pendientes" de Diego. Nadie ve los de nadie más.
///
/// Los campos de abajo de `doneAt` se añadieron al fusionar esa app: son opcionales
/// o tienen valor por defecto, así que lo que ya estaba guardado sigue igual.
model PersonalTask {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  done        Boolean   @default(false)
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// tarea, idea, video o skool
  kind       KindPendiente @default(TAREA)
  /// 0 normal · 1 importante (!) · 2 urgente (!!)
  priority   Int           @default(0)
  /// Para cuándo hay que terminarla. Solo la fecha, sin hora.
  due        DateTime?
  /// Las etiquetas libres que se escriben con #
  tags       String[]      @default([])
  /// El orden que la persona le dio arrastrando
  order      Int           @default(0)
  /// Si las subtareas se ven o están recogidas
  subsFolded Boolean       @default(false)

  /// Marcada para hoy con la estrella, como en la app de escritorio
  today      Boolean       @default(false)

  /// Cuándo se borró. La fila **no se elimina**: si desapareciera sin rastro, la app
  /// de escritorio (que todavía la tiene) la volvería a subir en la siguiente
  /// sincronización. Es la misma marca que usa allá. Se limpian a los 30 días.
  deletedAt  DateTime?

  /// Viene de la app de escritorio: su id de allá, para no importar dos veces
  externalId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subtasks PersonalSubtask[]

  @@unique([userId, externalId])
  @@index([userId, done])
  @@index([userId, deletedAt])
  @@index([userId, due])
}

/// Un paso dentro de un pendiente. Se borran con su pendiente.
model PersonalSubtask {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  taskId String
  task   PersonalTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, order])
}

/// El YouTube Planner, traído del Panel de Maestría. Allá cada alumno tiene el suyo;
/// aquí es **uno solo para todo el equipo**: lo que cambie cualquier administrador lo
/// ven los demás. Guarda tal cual lo que la herramienta escribía en el navegador
/// (una clave por sección: el contenido, la matriz, el banco de portadas…).
model PlannerDoc {
  /// La clave que usaba en el navegador: content_os_v2, cover_os_v1, etc.
  key       String   @id
  /// El JSON tal cual lo escribe la herramienta. No se interpreta aquí.
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  /// Quién lo tocó por última vez, para poder preguntar si algo se ve raro.
  updatedBy String?
}

// ══════════ DESAFÍOS ══════════
// El juego de los creadores del Club: cada persona da de alta sus páginas, va
// anotando sus seguidores y reclamando insignias. Todo esto son tablas NUEVAS: no
// toca ninguna de arriba, así que añadirlas no pone en riesgo ningún dato existente.
// El catálogo de insignias (qué escalones hay y cuántos puntos valen) vive en
// `lib/desafios.ts`, no en la base: cambiar un escalón no pide migrar nada.

enum RedSocial {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum TipoLogro {
  /// Seguidores en una red concreta
  SEGUIDORES
  /// Seguidores sumando todas las redes
  AUDIENCIA
  /// Un video con N vistas **en una página concreta** (y, en YouTube, en un formato)
  VISTAS
  /// Primer video con N likes
  LIKES
  /// Haber activado la monetización en alguna plataforma
  MONETIZACION
  /// Dinero ganado en total, en dólares
  INGRESOS
}

/// En YouTube los Shorts (vertical) y los videos largos (horizontal) se cuentan por
/// separado: cada uno tiene su propia escalera de vistas.
enum FormatoVideo {
  VERTICAL
  HORIZONTAL
}

enum EstadoLogro {
  ACTIVO
  /// Lo quitó el equipo. La fila se queda para que no se vuelva a reclamar a ciegas.
  REVOCADO
}

/// La ficha de creador de cada persona: «me llamo Miguel Ángel y tengo estas páginas».
model PerfilCreador {
  id     String  @id @default(cuid())
  /// Quién es. **Vacío solo en los perfiles de demostración** (`esDemo`): no son personas
  /// reales y no deben tener un usuario, o saldrían en la lista del equipo.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Perfil de mentira, para enseñar cómo se ve con datos. Se borran antes de publicar:
  /// `node scripts/desafios-demo.mjs --quitar`.
  esDemo Boolean @default(false)

  /// Cómo quiere que lo llamen en la tabla
  nombre String
  bio    String? @db.Text
  /// De qué hace contenido: cocina, finanzas, fitness…
  nicho  String?
  /// Su foto en Desafíos. Si falta, se usa la de su cuenta.
  foto   String? @db.Text

  /// La persona decide si sale en la tabla clasificatoria
  visible           Boolean @default(true)
  /// Si los demás ven sus cifras de seguidores. Las insignias se ven siempre.
  mostrarSeguidores Boolean @default(true)
  /// Si los demás ven cuánto gana. **Por defecto no**: es dinero.
  mostrarIngresos   Boolean @default(false)
  /// El equipo puede sacarla de la tabla (sin borrar nada suyo)
  ocultoPorEquipo   Boolean @default(false)
  /// Lo que el equipo quiera dejar anotado sobre esta persona. Solo lo ve el equipo.
  notaEquipo        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuentas  CuentaSocial[]
  logros   LogroCreador[]
  ingresos IngresoCreador[]

  @@index([visible, ocultoPorEquipo])
}

/// Una página o canal: un Instagram, un YouTube… Una persona puede tener varias de la
/// misma red.
model CuentaSocial {
  id       String        @id @default(cuid())
  perfilId String
  perfil   PerfilCreador @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  red        RedSocial
  /// Cómo se llama la página
  nombre     String
  /// Su dirección, ya normalizada (sin parámetros de rastreo)
  url        String
  foto       String?   @db.Text
  seguidores Int       @default(0)

  /// Cuándo se leyeron los seguidores directamente de la red (solo YouTube). Si está
  /// puesta, el dato no lo escribió la persona: es de fiar.
  leidoDeLaRed DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avances AvanceCuenta[]
  /// Los videos que esta página ha reclamado
  logros  LogroCreador[]

  @@unique([perfilId, url])
  @@index([perfilId])
}

/// Cada vez que se anota cuántos seguidores tiene una página queda una fila: de ahí
/// salen la gráfica de avance y la tabla de «quién crece más».
model AvanceCuenta {
  id         String       @id @default(cuid())
  cuentaId   String
  cuenta     CuentaSocial @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  seguidores Int
  nota       String?
  createdAt  DateTime     @default(now())

  @@index([cuentaId, createdAt])
}

/// Una insignia ganada. `clave` identifica el escalón del catálogo, p. ej.
/// `SEGUIDORES:INSTAGRAM:1000` o `VISTAS:10000`.
model LogroCreador {
  id       String        @id @default(cuid())
  perfilId String
  perfil   PerfilCreador @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  clave        String
  tipo         TipoLogro
  /// La red de los seguidores, o donde está el video de las vistas y los likes
  red          RedSocial?
  /// Solo en las vistas: la página a la que pertenece el video. Si la página se borra, la
  /// insignia se queda (es un logro) y `paginaNombre` recuerda cómo se llamaba.
  cuentaId     String?
  cuenta       CuentaSocial? @relation(fields: [cuentaId], references: [id], onDelete: SetNull)
  paginaNombre String?
  /// Solo en las vistas de YouTube: vertical (Shorts) u horizontal (videos largos)
  formato      FormatoVideo?
  umbral       Int
  estado       EstadoLogro   @default(ACTIVO)

  /// La prueba, opcional: el enlace al video y/o una captura
  enlace  String?
  captura String? @db.Text
  nota    String? @db.Text

  /// Si se concedió «de regalo» al reclamar un escalón más alto (quien tiene un video
  /// de 10 mil vistas ya pasó por las mil), la clave de ese escalón. Al quitar el alto
  /// se quitan también estos.
  origenClave String?

  creadoEn         DateTime  @default(now())
  revocadoEn       DateTime?
  revocadoPor      String?
  motivoRevocacion String?

  @@unique([perfilId, clave])
  @@index([perfilId, estado])
  @@index([estado, creadoEn])
  @@index([cuentaId])
}

/// Lo que una persona gana al mes en una plataforma. Una fila por (persona, red, mes):
/// volver a anotar el mismo mes la corrige en vez de sumarla otra vez. Siempre en
/// dólares, que es en lo que pagan YouTube y TikTok; se guarda en centavos para no
/// arrastrar errores de decimales.
model IngresoCreador {
  id       String        @id @default(cuid())
  perfilId String
  perfil   PerfilCreador @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  red      RedSocial
  /// El primer día del mes al que corresponde
  mes      DateTime  @db.Date
  centavos Int
  nota     String?
  /// La captura del panel de pagos, opcional
  captura  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([perfilId, red, mes])
  @@index([perfilId, mes])
}

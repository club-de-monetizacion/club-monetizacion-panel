# Base de datos Postgres (Neon, Vercel Postgres o Supabase). Debe incluir sslmode=require en produccion.
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# Genera un valor con: openssl rand -base64 33
AUTH_SECRET=""


# El panel del Club valida quién entra y con qué papel. Solo se cambia para apuntar a
# una copia de pruebas; por defecto es el de producción y esta app nunca lo modifica.
# PANEL_CLUB_URL="https://panel.clubdemonetizacion.com/api/encuesta"

# Salida de emergencia: si el panel estuviera caído, estos correos entran como ADMIN.
# Puede quedar vacía; lo normal es que el papel lo reparta el panel.
ADMIN_EMAILS=""

# Solo para pruebas en local: a dónde se le pregunta por la sesión del Club. Por
# defecto es https://clubdemonetizacion.com/api/sesion. En Vercel NO se pone.
# CLUB_SESION_URL="http://localhost:3190/api/sesion"

# Base de datos Postgres (Neon, Vercel Postgres o Supabase). Debe incluir sslmode=require en produccion.
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# Genera un valor con: openssl rand -base64 33
AUTH_SECRET=""

# Credenciales de Google Cloud Console (OAuth 2.0 Client ID, tipo "Web application")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Correos (separados por coma) que seran administradores automaticamente al iniciar sesion
ADMIN_EMAILS="clubdemonetizacion@gmail.com"
